// Cloud persistence for the Salon Rent Tracker.
// The app's working data lives client-side as JSON (tenants, credits, monthly
// data). We mirror those JSON blobs into Postgres so the data is durable,
// available across devices, and readable by the Command Center dashboard.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Supabase transaction pooler)
  directUrl = env("DIRECT_URL")   // direct/session (used by Prisma CLI)
}

/// One row per localStorage key: "salon-tenants", "salon-credits",
/// "salon-rent:YYYY-MM". `json` holds the exact structure the app already uses.
model AppState {
  key       String   @id
  json      Json
  updatedAt DateTime @updatedAt @default(now())
}

/// Tenant text messages captured from the iPhone (Shortcuts automation posts
/// each incoming text to /api/inbox/inbound). Powers the /inbox page.
/// The table is also created on first use by src/lib/inbox.ts, so no manual
/// migration is needed — keep the two definitions in step.
model InboxMessage {
  id         String    @id
  sender     String
  phone      String?
  body       String
  receivedAt DateTime  @default(now())
  tenantId   String?
  tenantName String?
  suite      String?
  /// "open" until handled, then "done"
  status     String    @default("open")
  draft      String?
  reply      String?
  handledAt  DateTime?
  task       String?
  taskDone   Boolean   @default(false)

  @@index([status])
}
